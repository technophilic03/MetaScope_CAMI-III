# --- toy_db/ : CAMI III human-gut-toy download, ~176 GB -----------------------
# Restore: wget -c -i toy_db/CAMI3_toy_dataset_download.list -P toy_db/
/toy_db/*
!/toy_db/CAMI3_toy_dataset_download.list
# Gold-standard profiles (15 MB, extracted from taxonomic_profiles.tar.gz).
# Uncomment to version them alongside benchmark results:
!/toy_db/taxonomic_profiles/

# --- db/ : NCBI taxonomy dumps + taxonomizr SQLite, ~36 GB --------------------
# Restore: fetch dumps (mirrored in reflib/2026_accession_taxa), then
#          Rscript --vanilla db/build_accession_tax.R
/db/*
!/db/build_accession_tax.R
!/db/build_accession_tax.log
!/db/readme.txt

# --- R session / HPC job artifacts -------------------------------------------
.Rhistory
.RData
.Rproj.user/
slurm-*.out
*_tmp/

# output logs
/output/*/logs/*.err
/output/*/logs/*.out
